{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutoramma",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "tutoramma" }
  ],
  // D1 database. Wrangler creates it automatically on the first deploy and
  // links it to this Worker; tables are created on the first request.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutor-amma-db",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI powers the Study Buddy, Concierge, Teaching Studio & Smart Flashcards.
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "LIVEHUB", "class_name": "LiveHubDO" },
      { "name": "CLASSROOMHUB", "class_name": "ClassroomHubDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveHubDO", "ClassroomHubDO"] }
  ],
  "vars": {
    "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_VISION_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   AUTH_SECRET      — signs session cookies (required in production)
  //   INTERNAL_SECRET  — shared secret between the LiveHub DO and internal API
  //   DEMO_RESET_KEY   — optional; allows POST /api/demo/reset with header x-demo-reset-key
}
